{
  "rules": {
    "gongsachecklist": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('gongsachecklistMembers').child($uid).child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('gongsachecklistMembers').child($uid).child(auth.uid).val() === true)",
        "$itemId": {
          ".validate": "newData.hasChildren(['idx', 'part', 'content', 'runcheck', 'bigo'])",
          "idx": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 9007199254740991 && newData.val() % 1 === 0 && $itemId === newData.val() + '' && (!data.exists() || newData.val() === data.val())"
          },
          "part": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
          },
          "content": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "runcheck": {
            ".validate": "newData.val() === 'no' || newData.val() === 'on'"
          },
          "bigo": {
            ".validate": "newData.isString() && newData.val().length <= 200000"
          },
          "$other": { ".validate": false }
        }
      }
    },
    "gongsachecklistMembers": {
      "$storeUid": {
        "$memberUid": {
          ".read": "auth != null && (auth.uid === $storeUid || auth.uid === $memberUid)",
          ".write": "auth != null && auth.uid === $storeUid",
          ".validate": "newData.val() === true"
        }
      }
    },
    "gongsachecklistProfiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "storeUid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && (newData.val() === auth.uid || root.child('gongsachecklistMembers').child(newData.val()).child(auth.uid).val() === true)"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
